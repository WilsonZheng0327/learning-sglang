---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import '../styles/stage.css';
import { chapters, parts } from '../chapters';
import { site } from '../site';
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import monoUrl from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

// MDX passes frontmatter both spread and as `frontmatter`; accept either.
const fm = (Astro.props as any).frontmatter ?? Astro.props;
const slug: string | undefined = fm.slug;
const idx = chapters.findIndex((c) => c.slug === slug);
const chapter = idx >= 0 ? chapters[idx] : undefined;
const title: string = fm.title ?? chapter?.title ?? site.name;
const hook: string | undefined = fm.hook ?? chapter?.hook;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pad = (n: number) => String(n).padStart(2, '0');
const prev = idx > 0 ? chapters[idx - 1] : undefined;
const next = idx >= 0 ? chapters[idx + 1] : undefined;
// what a shared link shows: the home page is the site alone, a chapter its title and hook; one card image for all (npm run og)
const pageTitle = chapter ? `${title} · ${site.name}` : site.name;
const description = chapter ? `Chapter ${idx + 1} of ${site.name}. ${hook ?? ''}`.trim() : `${site.tagline} An illustrated guide, one picture per chapter.`;
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const image = new URL(`${base}/og.png`, Astro.site);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <!-- preloaded so a page's first paint already has them: a font swapping in after it shifts the sidebar's text -->
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoUrl} as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <div class="shell">
      <nav class="sidebar">
        <div class="brandrow">
          <a class="brand" href={`${base}/`}>{site.name}</a>
          <button class="menu" type="button" aria-expanded="false" aria-controls="navbody">Chapters</button>
        </div>
        <div class="navbody" id="navbody">
        <p class="tagline">{site.tagline}</p>
        {parts.map((p) => (
          <div class="part">
            <div class="part-title">{p.title}</div>
            <ol>
              {chapters.map((c, i) => c.part === p.id && (
                <li class:list={[{ current: c.slug === slug, soon: !c.ready }]}>
                  {c.ready
                    ? <a href={`${base}/ch/${c.slug}/`}><span class="n">{pad(i + 1)}</span>{c.title}</a>
                    : <span><span class="n">{pad(i + 1)}</span>{c.title}</span>}
                </li>
              ))}
            </ol>
          </div>
        ))}
        <div class="hints"><kbd>←</kbd> <kbd>→</kbd> step</div>
        <p class="byline">by <a href={site.author.url}>{site.author.name}</a></p>
        <a class="repo" href={site.repo} target="_blank" rel="noopener">
          <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
          Star on GitHub
        </a>
        </div>
      </nav>
      <script is:inline>
        (() => {
          const nav = document.querySelector('.sidebar');
          const menu = nav.querySelector('.menu');
          menu.addEventListener('click', () => menu.setAttribute('aria-expanded', String(nav.classList.toggle('open'))));
          // Keep the sidebar where the reader left it across page loads. Runs before first paint, so it never jumps.
          // Only where the sidebar is its own scroll box: on a phone it is not, and scrollIntoView would scroll the page.
          if (!matchMedia('(min-width: 901px)').matches) return;
          let saved = null;
          try { saved = sessionStorage.getItem('sidebar-scroll'); } catch {}
          if (saved !== null) nav.scrollTop = +saved;
          else nav.querySelector('li.current')?.scrollIntoView({ block: 'center' });
          addEventListener('pagehide', () => { try { sessionStorage.setItem('sidebar-scroll', String(nav.scrollTop)); } catch {} });
        })();
      </script>
      {chapter ? (
        <main class="stage">
          <header class="stage-head">
            <div>
              <div class="kicker">Chapter {pad(idx + 1)}</div>
              <div class="titles">
                <h1>{title}</h1>
                {hook && <p class="hook">{hook}</p>}
              </div>
            </div>
            <nav class="chapter-nav" aria-label="chapters">
              {prev && (prev.ready ? <a href={`${base}/ch/${prev.slug}/`}>← {prev.title}</a> : <span>← {prev.title}</span>)}
              {next && (next.ready ? <a href={`${base}/ch/${next.slug}/`}>{next.title} →</a> : <span>{next.title} <em>soon</em> →</span>)}
            </nav>
          </header>
          <slot />
        </main>
      ) : (
        <main class="home"><slot /></main>
      )}
    </div>
  </body>
</html>
