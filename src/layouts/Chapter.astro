---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { chapters } from '../chapters';

// MDX passes frontmatter both spread and as `frontmatter`; accept either.
const fm = (Astro.props as any).frontmatter ?? Astro.props;
const slug: string | undefined = fm.slug;
const idx = chapters.findIndex((c) => c.slug === slug);
const chapter = idx >= 0 ? chapters[idx] : undefined;
const title: string = fm.title ?? chapter?.title ?? 'Learning SGLang';
const hook: string | undefined = fm.hook ?? chapter?.hook;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pad = (n: number) => String(n).padStart(2, '0');
const prev = idx > 0 ? chapters[idx - 1] : undefined;
const next = idx >= 0 ? chapters[idx + 1] : undefined;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title} · Learning SGLang</title>
  </head>
  <body>
    <div class="shell">
      <nav class="sidebar">
        <a class="brand" href={`${base}/`}>Learning SGLang</a>
        <p class="tagline">Inference engines, from the problems up.</p>
        <ol>
          {chapters.map((c, i) => (
            <li class:list={[{ current: c.slug === slug, soon: !c.ready }]}>
              {c.ready
                ? <a href={`${base}/ch/${c.slug}/`}><span class="n">{pad(i + 1)}</span>{c.title}</a>
                : <span><span class="n">{pad(i + 1)}</span>{c.title}</span>}
            </li>
          ))}
        </ol>
        <div class="hints"><kbd>←</kbd> <kbd>→</kbd> step<br /><kbd>space</kbd> play</div>
      </nav>
      {chapter ? (
        <main class="stage">
          <header class="stage-head">
            <div>
              <div class="kicker">Chapter {pad(idx + 1)}</div>
              <div class="titles">
                <h1>{title}</h1>
                {hook && <p class="hook">{hook}</p>}
              </div>
            </div>
            <nav class="chapter-nav" aria-label="chapters">
              {prev && (prev.ready ? <a href={`${base}/ch/${prev.slug}/`}>← {prev.title}</a> : <span>← {prev.title}</span>)}
              {next && (next.ready ? <a href={`${base}/ch/${next.slug}/`}>{next.title} →</a> : <span>{next.title} <em>soon</em> →</span>)}
            </nav>
          </header>
          <slot />
        </main>
      ) : (
        <main class="home"><slot /></main>
      )}
    </div>
  </body>
</html>
