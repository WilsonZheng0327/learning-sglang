---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { chapters, parts } from '../chapters';
import { site } from '../site';

// MDX passes frontmatter both spread and as `frontmatter`; accept either.
const fm = (Astro.props as any).frontmatter ?? Astro.props;
const slug: string | undefined = fm.slug;
const idx = chapters.findIndex((c) => c.slug === slug);
const chapter = idx >= 0 ? chapters[idx] : undefined;
const title: string = fm.title ?? chapter?.title ?? site.name;
const hook: string | undefined = fm.hook ?? chapter?.hook;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pad = (n: number) => String(n).padStart(2, '0');
const prev = idx > 0 ? chapters[idx - 1] : undefined;
const next = idx >= 0 ? chapters[idx + 1] : undefined;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title} · {site.name}</title>
  </head>
  <body>
    <div class="shell">
      <nav class="sidebar">
        <a class="brand" href={`${base}/`}>{site.name}</a>
        <p class="tagline">{site.tagline}</p>
        {parts.map((p) => (
          <div class="part">
            <div class="part-title">{p.title}</div>
            <ol>
              {chapters.map((c, i) => c.part === p.id && (
                <li class:list={[{ current: c.slug === slug, soon: !c.ready }]}>
                  {c.ready
                    ? <a href={`${base}/ch/${c.slug}/`}><span class="n">{pad(i + 1)}</span>{c.title}</a>
                    : <span><span class="n">{pad(i + 1)}</span>{c.title}</span>}
                </li>
              ))}
            </ol>
          </div>
        ))}
        <div class="hints"><kbd>←</kbd> <kbd>→</kbd> step<br /><kbd>space</kbd> play</div>
        <p class="byline">by <a href={site.author.url}>{site.author.name}</a></p>
        <a class="repo" href={site.repo} target="_blank" rel="noopener">
          <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
          Star on GitHub
        </a>
      </nav>
      {chapter ? (
        <main class="stage">
          <header class="stage-head">
            <div>
              <div class="kicker">Chapter {pad(idx + 1)}</div>
              <div class="titles">
                <h1>{title}</h1>
                {hook && <p class="hook">{hook}</p>}
              </div>
            </div>
            <nav class="chapter-nav" aria-label="chapters">
              {prev && (prev.ready ? <a href={`${base}/ch/${prev.slug}/`}>← {prev.title}</a> : <span>← {prev.title}</span>)}
              {next && (next.ready ? <a href={`${base}/ch/${next.slug}/`}>{next.title} →</a> : <span>{next.title} <em>soon</em> →</span>)}
            </nav>
          </header>
          <slot />
        </main>
      ) : (
        <main class="home"><slot /></main>
      )}
    </div>
  </body>
</html>
